build --disk_cache=~/.cache/bazel-disk

# APPLYPROJECTION EXPERIMENTS

# Depthwise fused ApplyProjection: one depth-batch scheduler over all node/projection
# tasks, preserving ordinary per-node Sparse Oblique RF projection sampling.
build:depthwise_1_pass --cxxopt="-DDEPTHWISE_1_PASS=1"

# DW1 shared-rows colwalk: a variant of --config=depthwise_1_pass. In the
# column-centric block, read each touched column ONCE over the block's merged
# bag (union of its nodes' selected_examples, sorted by row id) and scatter each
# value to its owning node's projections, instead of re-gathering the column per
# (node, projection). Trades the per-node sparse gather for a stride-1 read plus
# sparse writes into the output slabs. A/B against plain --config=depthwise_1_pass:
# compare the Dw1SweepColWalk chrono line (the new merged-bag prep shows up as
# Dw1SharedBag). YDF_DW1_BLOCK_FLOATS now bounds the scatter-write working set,
# so tune it down if the block's output slabs spill LLC.
#
# The merged bag is packed as hwy::K32V32 (8 B/row): VQSort orders by the 32-bit
# example id (key); the 32-bit value carries only the owning node. The row's
# local slab slot is NOT stored -- selected_examples are sorted ascending, so the
# row-sorted bag visits each node's rows in slab order and `local` is recovered
# as a per-node counter during the colwalk. Requires the default 32-bit example
# index (NOT compatible with --define=ydf_example_idx_num_bits=64; a static_assert
# enforces this).
build:dw1_shared_rows --config=depthwise_1_pass
build:dw1_shared_rows --cxxopt="-DDW1_SHARED_ROWS=1"

# Hidden synthetic-layout experiments for ProjectionEvaluator. These change
# numerical-feature storage for trunk synthetic datasets only; they are
# scheduler-independent and can be combined with default Nodewise or Depthwise.
build:row_major_dataset_layout --cxxopt="-DROW_MAJOR_DATASET_LAYOUT=1"
build:flat_col_dataset_layout --cxxopt="-DFLAT_COL_DATASET_LAYOUT=1"


## SYMMETRIC TREES
# CatBoost-style symmetric/oblivious trees for Sparse Oblique RF: K candidate projections
# shared across all nodes at depth d, one bag-wide sweep per candidate. Hooks
# into GrowTreeLocalBFS's depth-batch loop. Implies BFS scheduling.

# NOTE this does not include the shared Entropy logic of CatBoost, where only 1 entropy
#  calculation per depth is done
build:symmetric_depthwise_ap --cxxopt="-DSYMMETRIC_DEPTHWISE_AP=1"
# Symmetric_Nodewise_Control: control experiment that isolates the
# shared-projection-sampling effect from the bagwide column-read effect.
# K projections are sampled once per depth and reused by every node at that
# depth, but each node still runs the normal node-local
# ProjectionEvaluator::Evaluate path. Do not combine with
# --config=symmetric_depthwise_ap (the AP path would shadow the control).
build:symmetric_nodewise_control --cxxopt="-DSYMMETRIC_NODEWISE_CONTROL=1"
# BFS_Only: deeper control that isolates the cost/benefit of just the BFS
# (level-order) scheduler vs. DFS. Triggers GrowTreeLocalBFS, but does NOT
# sample shared projections and does NOT call any fused bag-wide Apply. Each
# node at a depth runs the normal per-node projection sampling and the
# standard per-node ProjectionEvaluator::Evaluate path — identical to the
# Nodewise baseline algorithmically, only the tree-traversal order differs.
# Despite living next to the symmetric_* configs in this file (because it is
# the BFS-only control for the symmetric-trees ablation series), no symmetric
# behavior is involved. Mutually exclusive with symmetric_depthwise_ap and
# symmetric_nodewise_control.
build:bfs_only --cxxopt="-DBFS_ONLY=1"

# Subtree gather cache: memory-safe replacement for the Dynamic_Row_Col_Major
# dual store. Keeps the single column-major dataset; nodes with <=
# YDF_RM_MAX_ROWS (default 5000) rows gather the feature columns their
# projections touch into compact per-subtree buffers (lazily, reused by all
# descendant nodes under DFS). Extra memory is capped at YDF_SG_BUDGET_MB
# (default 1024) per training thread instead of a second full dataset copy.
# Run with the plain --dataset_layout=column; do not combine with the
# *_dataset_layout configs.
build:subtree_gather --cxxopt="-DSUBTREE_GATHER_CACHE=1"

# Reuse one ProjectionEvaluator per thread instead of rebuilding its
# per-attribute pointer tables on every node (kFindObliqueSetup waste).
# Bit-identical; disabled automatically under RANDOM_LOCAL_IMPUTATION.
build:cache_projection_evaluator --cxxopt="-DCACHE_PROJECTION_EVALUATOR=1"


##### GPU Support
build:oblique_gpu --cxxopt="-DOBLIQUE_GPU_ENABLED=1" --define=enable_cuda=1

# INSTRUMENTATION & DEFAULTS


# Two-tier chrono profiling. CHRONO_PROFILE=2 is the fine tier (every scope);
# CHRONO_PROFILE=1 is the coarse tier (only the top-level scopes — TreeTrain,
# NodeTrain, SampleProjection, EvaluateProj, ProjectionEvaluate, BfsNodeLoop)
# for lower measurement overhead.
build:chrono_profile --cxxopt="-DCHRONO_PROFILE=2"
build:chrono_profile_coarse --cxxopt="-DCHRONO_PROFILE=1"
# Don't Inlining ApplyProjection for more accurate profiling by Default. Very small cost: <2% e2e
build:inline_projection_evaluate --cxxopt="-DYDF_INLINE_PROJECTION_EVALUATE"
# Skip the std::isnan branch in ProjectionEvaluator::Evaluate. by default. again small cost but possible cache misbehavior
build:enable_applyprojection_isnan --cxxopt="-DENABLE_APPLYPROJECTION_ISNAN=1"

# Precomputed count*log(count) lookup table ON by default for unweighted binary entropy in RF/SPORF Exact 
#   ~9% e2e runtime win, ~39% local on SortScanSplits)
build:disable_binary_entropy_lookup --cxxopt="-DDISABLE_BINARY_ENTROPY_LOOKUP"

# STD::UPPER_BOUND VECTORIZATION
build:enable_std_upper_bound_avx2 --cxxopt="-mavx2" --cxxopt="-mfma" --cxxopt="-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1"
build:enable_std_upper_bound_avx512 --cxxopt="-mavx512f" --cxxopt="-mfma" --cxxopt="-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1"

# Default ON: tune for the host CPU and enable std::upper_bound AVX2 vectorization
# for every build (no --config needed). -march=native already implies -mavx2/-mfma
# on AVX2-capable hosts, so only the vectorization define is added here.
# NOTE: -march=native is host-specific and will break cross-compiles (e.g. wasm);
# scope these under build:linux/build:macos if you ever cross-compile.
build --copt=-march=native --cxxopt="-O3"
build --cxxopt=-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1


# DEFAULTS


# Auto-apply the build:linux / build:macos / build:windows configs based on
# the host OS, so the compiler pins below take effect without needing an
# explicit --config on the command line.
build --enable_platform_specific_config

# pin Intel oneAPI ICX (clang-based) on Linux. Without this, Bazel's
# auto-detection silently falls back to /usr/bin/gcc, which compiles the
# Oblique Exact hot path ~30-40% slower than ICX. Requires oneAPI to be
# sourced in the shell (`source /opt/intel/oneapi/setvars.sh`) so that
# `icx` / `icpx` are on PATH for Bazel's cc_configure rule. This is pinned
# under build:linux (not global) so that on Linux a missing icx is a hard
# error -- it must not silently fall back to gcc, which would invalidate
# performance numbers. macOS cannot use icx (Intel never shipped icx/icpx
# for macOS, and not at all for Apple Silicon), so it intentionally has no
# pin and uses the native Apple clang toolchain instead.
build:linux --repo_env=CC=icx
build:linux --repo_env=CXX=icpx

# Compile *all* C++ code (target and host) in C++17 mode.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17
build --ui_event_filters=-warning,-debug

# Breakpoints don't get hit without this!
# Can't seem to add to bazel dbg using build:dbg!! Have to Define separate config
build:debug --strip=never          # keep symbols, don’t fiddle with fission
build:debug --cxxopt=-g --linkopt=-g
build:debug --cxxopt=-O0 --linkopt=-O0 --cxxopt=-fno-inline
build:debug --copt=-D_GLIBCXX_DEBUG # vector range checks


build:profiler --strip=never   # keep symbols
build:profiler --cxxopt=-g --linkopt=-g
build:profiler --cxxopt=-O2 --linkopt=-O2
# Make sure split-DWARF is off – VTune hates .dwo/.dwp
build:profiler --features=-fission
build:profiler --cxxopt=-gno-split-dwarf


# CUDA: use GCC-13 as nvcc host compiler (ICX not officially supported by NVIDIA)
build --action_env=CUDA_PATH=/usr/local/cuda
build --repo_env=CUDA_HOME=/usr/local/cuda
build --action_env=NVCC_PREPEND_FLAGS="-ccbin=/usr/bin/g++-13"


# Bazel configuration for Yggdrasil Decision Forests
#
# OPTIONS
#
# Linux
#
#   linux_cpp17: Linux build. Uses C++17.
#
# Linux options:
#
#   linux_avx2: AVX2.
#
# Windows
#
#  On Windows, uncomment the output_user_root option to avoid long path issues.
#
#   windows_cpp17: Windows build. Uses C++17.
#
# Windows options:
#
#   windows_avx2: AVX2.
#
# TensorFlow Defines:
#
#   use_tensorflow_io=1: Uses tensorflow for IO operations. Otherwise, use the
#     c++ Standard Library <filesystem>. Note: <filesystem> does not exist in
#     cpp<=14 and it had some issue with gcc<=8. Required to consume dataset
#     encoded as TFRecord of TF.Examples.
#   tensorflow_with_header_lib=1: Uses tensorflow header only library. Useful to
#     use tensorflow dynamic linking. Otherwise, links tensorflow statically (if
#     tensorflow is used).


build --incompatible_enable_cc_toolchain_resolution

# Avoid long path issues on Windows
# startup --output_user_root=C:/tmpbld

# Flags to compile with or without recent version of Bazel.

# Required for bazel <=4, fails with bazel >= 5.
# common --incompatible_restrict_string_escapes=false

build -c opt
build --announce_rc
build --noincompatible_strict_action_env

# Silence all C++ compiler warnings unconditionally (the build:linux
# variants below only fire under --config=linux).
build --copt=-w
build --host_copt=-w

# Enable after adding python headers to protobuf.
build --define=use_fast_cpp_protos=true
build --define=allow_oversize_protos=true
build --define=grpc_no_ares=true

# Nice print
build:linux --copt=-fdiagnostics-color=always
build --color=yes

# Disable dependencies to Tensorflow.
build --define=use_ydf_tensorflow_proto=1

# Suppress C++ compiler warnings.
build:linux --copt=-w
build:linux --host_copt=-w
build:macos --copt=-w
build:windows --copt=/W0
build:wasm --copt=-w
build:wasm --host_copt=-w

# Build mode.
build:linux_cpp17 --cxxopt=-std=c++17
build:linux_cpp17 --host_cxxopt=-std=c++17
build:linux_cpp17 --config=linux

build:macos --cxxopt=-std=c++17
build:macos --host_cxxopt=-std=c++17

build:windows_cpp17 --cxxopt=/std:c++17
build:windows_cpp17 --host_cxxopt=/std:c++17
build:windows_cpp17 --config=windows

build:windows_cpp20 --cxxopt=/std:c++20
build:windows_cpp20 --host_cxxopt=/std:c++20
build:windows_cpp20 --config=windows

# Instruction set optimizations
build:linux_avx2 --copt=-mavx2
build:windows_avx2 --copt=/arch:AVX2

# Misc build options we need for windows.
build:windows --copt=/D_USE_MATH_DEFINES
build:windows --host_copt=/D_USE_MATH_DEFINES
build:windows --copt=-DWIN32_LEAN_AND_MEAN
build:windows --host_copt=-DWIN32_LEAN_AND_MEAN
build:windows --copt=-DNOGDI
build:windows --host_copt=-DNOGDI
build:windows --linkopt=/NDEBUG
build:windows --host_linkopt=/NDEBUG
build:windows --linkopt=/OPT:REF
build:windows --host_linkopt=/OPT:REF
build:windows --linkopt=/OPT:ICF
build:windows --host_linkopt=/OPT:ICF
build:windows --experimental_strict_action_env=true
build:windows --copt=/Zc:preprocessor
build:windows --host_copt=/Zc:preprocessor
build:windows --materialize_param_files
build:windows --features=compiler_param_file
build:windows --verbose_failures
build:windows --copt=/Oi
build:windows --host_copt=/Oi
build:windows --copt=/GL
build:windows --host_copt=/GL

# Wasm
# build:wasm --crosstool_top=@emsdk//emscripten_toolchain:everything
build:wasm --cpu=wasm
# build:wasm --host_crosstool_top=@bazel_tools//tools/cpp:toolchain
build:wasm --copt="-Wno-deprecated-non-prototype"
build:wasm --copt="-Wno-unused-value"
build:wasm --copt="-Wno-unused-function"
build:wasm --copt="-Wno-deprecated-declarations"
build:wasm --copt="-Wno-unused-lambda-capture"
build:wasm --spawn_strategy=local
build:wasm --cxxopt=-std=c++17
build:wasm --host_cxxopt=-std=c++17
build:wasm --host_cxxopt="-fno-exceptions"

# Optional. Just to make it compatible with dynamic linking and TensorFlow.
# build --cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
# build --host_cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
