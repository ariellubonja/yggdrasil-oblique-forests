build --disk_cache=~/.cache/bazel-disk

# APPLYPROJECTION EXPERIMENTS

# Depthwise fused ApplyProjection: one depth-batch scheduler over all
# node/projection tasks, keeping per-node Sparse Oblique RF projection sampling.
build:depthwise_1_pass --cxxopt="-DDEPTHWISE_1_PASS=1"

# DW1 shared-rows colwalk: variant of depthwise_1_pass. In the column-centric
# block, read each touched column ONCE over the block's merged bag (union of its
# nodes' selected_examples, sorted by row id) and scatter values to each owning
# node's projections, instead of re-gathering the column per (node, projection).
# Trades the per-node sparse gather for a stride-1 read plus sparse slab writes.
# A/B vs plain depthwise_1_pass: compare the Dw1SweepColWalk chrono line (merged-
# bag prep shows as Dw1SharedBag). YDF_DW1_BLOCK_FLOATS bounds the scatter-write
# working set; tune down if output slabs spill LLC.
#
# Merged bag is packed as hwy::K32V32 (8 B/row): VQSort orders by the 32-bit
# example id (key); the 32-bit value carries only the owning node. The local slab
# slot is NOT stored -- selected_examples are sorted ascending, so the row-sorted
# bag visits each node's rows in slab order and `local` is recovered as a per-node
# counter during the colwalk. Requires the default 32-bit example index (NOT
# compatible with --define=ydf_example_idx_num_bits=64; static_assert enforces it).
build:dw1_shared_rows --config=depthwise_1_pass
build:dw1_shared_rows --cxxopt="-DDW1_SHARED_ROWS=1"

# Synthetic-layout experiments for ProjectionEvaluator: change numerical-feature
# storage for trunk synthetic datasets only. Scheduler-independent; combinable
# with default Nodewise or Depthwise.
build:row_major_dataset_layout --cxxopt="-DROW_MAJOR_DATASET_LAYOUT=1"


## SYMMETRIC TREES
# CatBoost-style symmetric/oblivious trees for Sparse Oblique RF: K candidate
# projections shared across all nodes at depth d, one bag-wide sweep per
# candidate. Hooks into GrowTreeLocalBFS's depth-batch loop. Implies BFS.
# NOTE: does not include CatBoost's shared-entropy logic (1 entropy calc/depth).
# Runtime knob YDF_SYMMETRIC_MAX_DEPTH (default INT32_MAX = symmetric everywhere)
# caps the symmetric depth: levels deeper than it hand each frontier node off to
# the DFS grower (GrowTreeLocal). =0 is all-DFS. See SymmetricMaxDepth() in
# learner/decision_tree/training.cc; swept by benchmarks' dw1_depth_linesearch.sh
# --mode=symmetric.
build:symmetric_depthwise_ap --cxxopt="-DSYMMETRIC_DEPTHWISE_AP=1"
# BFS_Only: isolates the cost/benefit of the BFS (level-order) scheduler vs DFS.
# Triggers GrowTreeLocalBFS but does NOT sample shared projections or call any
# fused bag-wide Apply -- each node runs the normal per-node sampling + Evaluate,
# algorithmically identical to the Nodewise baseline, only traversal order
# differs. Lives by the symmetric_* configs as their BFS-only control but
# involves no symmetric behavior. Mutually exclusive with symmetric_depthwise_ap.
build:bfs_only --cxxopt="-DBFS_ONLY=1"

##### GPU Support
build:oblique_gpu --cxxopt="-DOBLIQUE_GPU_ENABLED=1" --define=enable_cuda=1

# INSTRUMENTATION & DEFAULTS


# Two-tier chrono profiling. =2 is fine (every scope); =1 is coarse (only the
# top-level scopes: TreeTrain, NodeTrain, SampleProjection, EvaluateProj,
# ProjectionEvaluate, BfsNodeLoop) for lower measurement overhead.
build:chrono_profile --cxxopt="-DCHRONO_PROFILE=2"
build:chrono_profile_coarse --cxxopt="-DCHRONO_PROFILE=1"
# Don't inline ApplyProjection, for more accurate profiling. Very small cost: <2% e2e.
build:inline_projection_evaluate --cxxopt="-DYDF_INLINE_PROJECTION_EVALUATE"
# Skip the std::isnan branch in Evaluate. Small cost but possible cache misbehavior.
build:enable_isnan --cxxopt="-DENABLE_ISNAN=1"

# Precomputed count*log(count) lookup table, ON by default for unweighted binary
# entropy in RF/SPORF Exact (~9% e2e win, ~39% local on SortScanSplits).
build:disable_binary_entropy_lookup --cxxopt="-DDISABLE_BINARY_ENTROPY_LOOKUP"

# STD::UPPER_BOUND VECTORIZATION
build:enable_std_upper_bound_avx2 --cxxopt="-mavx2" --cxxopt="-mfma" --cxxopt="-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1"
build:enable_std_upper_bound_avx512 --cxxopt="-mavx512f" --cxxopt="-mfma" --cxxopt="-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1"

# Default ON: tune for the host CPU + enable std::upper_bound AVX2 vectorization
# for every build (no --config needed). -march=native already implies -mavx2/-mfma
# on AVX2 hosts, so only the vectorization define is added here.
# NOTE: -march=native is host-specific and breaks cross-compiles (e.g. wasm);
# scope under build:linux/build:macos if you ever cross-compile.
build --copt=-march=native --cxxopt="-O3"
build --cxxopt=-DENABLE_STD_UPPER_BOUND_VECTORIZATION=1


# DEFAULTS


# Auto-apply build:linux / build:macos / build:windows by host OS, so the
# compiler pins below take effect without an explicit --config.
build --enable_platform_specific_config

# Pin Intel oneAPI ICX (clang-based) on Linux. Without this, Bazel auto-detection
# silently falls back to /usr/bin/gcc, which compiles the Oblique Exact hot path
# ~30-40% slower than ICX. Requires oneAPI sourced in the shell
# (`source /opt/intel/oneapi/setvars.sh`) so icx/icpx are on PATH for Bazel's
# cc_configure. Pinned under build:linux (not global) so a missing icx is a hard
# error rather than a silent gcc fallback that invalidates perf numbers. macOS
# has no pin (Intel never shipped icx/icpx for macOS/Apple Silicon) and uses the
# native Apple clang toolchain.
build:linux --repo_env=CC=icx
build:linux --repo_env=CXX=icpx

# Compile *all* C++ code (target and host) in C++17 mode.
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17
build --ui_event_filters=-warning,-debug

# Breakpoints don't get hit without this!
# Can't seem to add to bazel dbg using build:dbg!! Have to Define separate config
build:debug --strip=never          # keep symbols, don’t fiddle with fission
build:debug --cxxopt=-g --linkopt=-g
build:debug --cxxopt=-O0 --linkopt=-O0 --cxxopt=-fno-inline
build:debug --copt=-D_GLIBCXX_DEBUG # vector range checks


build:profiler --strip=never   # keep symbols
build:profiler --cxxopt=-g --linkopt=-g
build:profiler --cxxopt=-O2 --linkopt=-O2
# Make sure split-DWARF is off – VTune hates .dwo/.dwp
build:profiler --features=-fission
build:profiler --cxxopt=-gno-split-dwarf


# CUDA: use GCC-13 as nvcc host compiler (ICX not officially supported by NVIDIA)
build --action_env=CUDA_PATH=/usr/local/cuda
build --repo_env=CUDA_HOME=/usr/local/cuda
build --action_env=NVCC_PREPEND_FLAGS="-ccbin=/usr/bin/g++-13"


# Bazel configuration for Yggdrasil Decision Forests
#
# OPTIONS
#
# Linux
#
#   linux_cpp17: Linux build. Uses C++17.
#
# Linux options:
#
#   linux_avx2: AVX2.
#
# Windows
#
#  On Windows, uncomment the output_user_root option to avoid long path issues.
#
#   windows_cpp17: Windows build. Uses C++17.
#
# Windows options:
#
#   windows_avx2: AVX2.
#
# TensorFlow Defines:
#
#   use_tensorflow_io=1: Uses tensorflow for IO operations. Otherwise, use the
#     c++ Standard Library <filesystem>. Note: <filesystem> does not exist in
#     cpp<=14 and it had some issue with gcc<=8. Required to consume dataset
#     encoded as TFRecord of TF.Examples.
#   tensorflow_with_header_lib=1: Uses tensorflow header only library. Useful to
#     use tensorflow dynamic linking. Otherwise, links tensorflow statically (if
#     tensorflow is used).


build --incompatible_enable_cc_toolchain_resolution

# Avoid long path issues on Windows
# startup --output_user_root=C:/tmpbld

# Flags to compile with or without recent version of Bazel.

# Required for bazel <=4, fails with bazel >= 5.
# common --incompatible_restrict_string_escapes=false

build -c opt
build --announce_rc
build --noincompatible_strict_action_env

# Silence all C++ compiler warnings unconditionally (the build:linux
# variants below only fire under --config=linux).
build --copt=-w
build --host_copt=-w

# Enable after adding python headers to protobuf.
build --define=use_fast_cpp_protos=true
build --define=allow_oversize_protos=true
build --define=grpc_no_ares=true

# Nice print
build:linux --copt=-fdiagnostics-color=always
build --color=yes

# Disable dependencies to Tensorflow.
build --define=use_ydf_tensorflow_proto=1

# Suppress C++ compiler warnings.
build:linux --copt=-w
build:linux --host_copt=-w
build:macos --copt=-w
build:windows --copt=/W0
build:wasm --copt=-w
build:wasm --host_copt=-w

# Build mode.
build:linux_cpp17 --cxxopt=-std=c++17
build:linux_cpp17 --host_cxxopt=-std=c++17
build:linux_cpp17 --config=linux

build:macos --cxxopt=-std=c++17
build:macos --host_cxxopt=-std=c++17

build:windows_cpp17 --cxxopt=/std:c++17
build:windows_cpp17 --host_cxxopt=/std:c++17
build:windows_cpp17 --config=windows

build:windows_cpp20 --cxxopt=/std:c++20
build:windows_cpp20 --host_cxxopt=/std:c++20
build:windows_cpp20 --config=windows

# Instruction set optimizations
build:linux_avx2 --copt=-mavx2
build:windows_avx2 --copt=/arch:AVX2

# Misc build options we need for windows.
build:windows --copt=/D_USE_MATH_DEFINES
build:windows --host_copt=/D_USE_MATH_DEFINES
build:windows --copt=-DWIN32_LEAN_AND_MEAN
build:windows --host_copt=-DWIN32_LEAN_AND_MEAN
build:windows --copt=-DNOGDI
build:windows --host_copt=-DNOGDI
build:windows --linkopt=/NDEBUG
build:windows --host_linkopt=/NDEBUG
build:windows --linkopt=/OPT:REF
build:windows --host_linkopt=/OPT:REF
build:windows --linkopt=/OPT:ICF
build:windows --host_linkopt=/OPT:ICF
build:windows --experimental_strict_action_env=true
build:windows --copt=/Zc:preprocessor
build:windows --host_copt=/Zc:preprocessor
build:windows --materialize_param_files
build:windows --features=compiler_param_file
build:windows --verbose_failures
build:windows --copt=/Oi
build:windows --host_copt=/Oi
build:windows --copt=/GL
build:windows --host_copt=/GL

# Wasm
# build:wasm --crosstool_top=@emsdk//emscripten_toolchain:everything
build:wasm --cpu=wasm
# build:wasm --host_crosstool_top=@bazel_tools//tools/cpp:toolchain
build:wasm --copt="-Wno-deprecated-non-prototype"
build:wasm --copt="-Wno-unused-value"
build:wasm --copt="-Wno-unused-function"
build:wasm --copt="-Wno-deprecated-declarations"
build:wasm --copt="-Wno-unused-lambda-capture"
build:wasm --spawn_strategy=local
build:wasm --cxxopt=-std=c++17
build:wasm --host_cxxopt=-std=c++17
build:wasm --host_cxxopt="-fno-exceptions"

# Optional. Just to make it compatible with dynamic linking and TensorFlow.
# build --cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
# build --host_cxxopt="-D_GLIBCXX_USE_CXX11_ABI=0"
