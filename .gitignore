**/.venv/

# Per-experiment heavy/regeneratable artifacts (perf records, raw run logs).
# Light, structured outputs (CSVs, .md write-ups) live elsewhere and ARE tracked.
.claude/*
!.claude/skills/
benchmarks/experiments/*/perf_runs/
benchmarks/experiments/*/iteration_logs/

# eval_ab_e2e.py per-run dirs — heavy raw stdout logs. Summary.md is captured
# in benchmarks/results/apply_projection_experiments.md.
benchmarks/results/eval_ab/



# Raw input datasets dropped directly under benchmarks/data/ (HIGGS, wise1,
# haberman, etc.) — heavy/regeneratable, don't track. Only first-level CSVs;
# curated subdir CSVs (e.g. cc18_binary_csv/) are unaffected.
benchmarks/data/*.csv

# per_function_timing: track only the raw/ CSVs, ignore the aggregated
# sibling copies that sit directly under each dataset dir.
benchmarks/results/per_function_timing/**/*.csv
!benchmarks/results/per_function_timing/**/raw/*.csv

ariel_notes/
GBT.md
dw1.md

# Downloaded benchmark suites (TabArena via OpenML, TabReD via Kaggle). Recreate
# with benchmarks/data/download_{tabarena,tabred}_datasets.py, run under the
# repo-root .venv; the pinned TabArena dataset list under tabarena/_meta/ IS
# tracked.
benchmarks/data/tabarena/*
!benchmarks/data/tabarena/_meta/
benchmarks/data/tabarena/_meta/openml_cache/
benchmarks/data/tabred/
benchmarks/data/processed/

# A/B build artifacts copied next to their run logs (scripts + logs ARE tracked).
benchmarks/results/**/bin/
